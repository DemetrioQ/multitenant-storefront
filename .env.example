# Absolute URL of the saas-api backend. Leave empty in prod to use same-origin
# (browser sends the tenant Host header). In local dev, point this at the backend
# so SSR requests can reach it and a `storeSlug` query fallback is auto-added.
NEXT_PUBLIC_API_URL=https://localhost:7079

# Uncomment in local dev ONLY if saas-api is using the ASP.NET Core self-signed
# dev certificate (the default for `dotnet run`). Node's fetch rejects untrusted
# TLS certs, so without this the storefront can't call the backend over HTTPS.
# Never set this in production.
# NODE_TLS_REJECT_UNAUTHORIZED=0
